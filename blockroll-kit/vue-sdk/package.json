{
  "name": "@blockroll/vue-sdk",
  "version": "1.0.0",
  "description": "BlockRoll Vue SDK - Secure data exchange for Vue.js applications",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node init && rollup -c",
