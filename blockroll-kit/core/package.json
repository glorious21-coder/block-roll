{
  "name": "@blockroll/core",
  "version": "1.0.0",
  "description": "BlockRoll Core SDK - Secure data exchange and storage platform",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node init && rollup -c",
    "dev": "node init && rollup -c -w",
