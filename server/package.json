    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.2",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.6.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
